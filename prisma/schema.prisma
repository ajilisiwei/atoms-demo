generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  // Null for users who signed up via OAuth only
  passwordHash String?
  name         String?
  avatarUrl    String?
  // Generation credits: 1 credit per 1K LLM tokens; new accounts start with 1000
  credits      Int            @default(1000)
  projects     Project[]
  oauthAccounts OAuthAccount[]
  creditLedger CreditLedger[]
  customThemes CustomTheme[]
  agents       Agent[]
  createdAt    DateTime       @default(now())
}

// A buddy persona. The built-ins and user-created ones share this table so the
// picker, the @-mention menu and Project.agentId all speak one id space:
// built-ins are seeded with a stable slug id ("timo", "ledger", …) and no
// owner, custom ones get a cuid and belong to their creator.
model Agent {
  // Built-ins are seeded with an explicit slug id, which wins over the default;
  // custom buddies let the client generate one.
  id             String   @id @default(cuid())
  // "builtin" | "custom"
  kind           String   @default("builtin")
  // Picker section: "work" | "life" for built-ins, "custom" for user-created
  group          String   @default("life")
  // Null for built-ins; set for custom buddies
  ownerId        String?
  owner          User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name           String
  tagline        String
  taglineZh      String
  // Appended to the build system prompt when this buddy drives a generation
  persona        String   @db.Text
  avatarUrl      String
  // StarterPrompt[] (see src/lib/agent-types.ts); null when the buddy has none
  starterPrompts Json?
  // Built-in theme id suggested alongside this buddy (see src/lib/themes.ts)
  themeHint      String?
  sortOrder      Int      @default(0)
  // Retires a built-in without deleting rows that projects still reference
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ownerId])
}

model CreditLedger {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Negative = spent, positive = granted
  delta     Int
  tokens    Int?
  reason    String // "generation" | "signup_grant" | ...
  projectId String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // "github" | "google"
  providerAccountId String
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
}

// A user-authored theme from Theme Studio. Referenced by Project.themeName as
// "custom:<id>"; the built-in themes use their bare id instead.
model CustomTheme {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  // Built-in theme id this was forked from (see src/lib/themes.ts); null when
  // authored from scratch.
  baseTheme String?
  // ThemeTokens (see src/lib/theme-tokens.ts), validated before every write.
  tokens    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

model Project {
  id                 String       @id @default(cuid())
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  // Generation target: "html" (single self-contained document) | "react-ts" (multi-file app)
  template           String       @default("html")
  // Generation theme id (see src/lib/themes.ts); null = no theme constraint
  themeName          String?
  // Built-in agent persona id (see src/lib/agents.ts); null = default builder
  agentId            String?
  // Starred by the owner; pinned into the sidebar's Favorites group
  favorite           Boolean      @default(false)
  // Set when this project was remixed from a published project
  remixedFromId      String?
  remixedFrom        Project?     @relation("Remixes", fields: [remixedFromId], references: [id], onDelete: SetNull)
  remixes            Project[]    @relation("Remixes")
  // Denormalized count of remixes made from this project
  remixCount         Int          @default(0)
  // Set when the project is published; used as the public URL path /p/[slug]
  slug               String?      @unique
  publishedVersionId String?      @unique
  publishedVersion   AppVersion?  @relation("PublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  messages           Message[]
  versions           AppVersion[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model Message {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role      String // "user" | "assistant"
  content   String
  // Agent plan steps captured for assistant messages, rendered as the timeline
  planSteps Json?
  // Follow-up suggestions ("Add ...") emitted after a build, shown as chips
  suggestions Json?
  createdAt DateTime @default(now())
}

model AppVersion {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number        Int
  // Single-document output for "html" projects; empty string for "react-ts"
  html          String
  // Full file snapshot { path: content } for "react-ts" projects
  files         Json?
  // Browser-built bundle for "react-ts" projects, used by preview and publishing
  compiledHtml  String?
  promptSummary String
  createdAt     DateTime @default(now())
  publishedFor  Project? @relation("PublishedVersion")

  @@unique([projectId, number])
}
